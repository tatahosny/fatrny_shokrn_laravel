{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["resources/js/*"]
        },
        "types": ["node", "vite/client"]
    },
    "include": ["resources/js/**/*"],
    "exclude": ["node_modules", "public", "vendor", "فطارنى", "storage", ".next"]
}
